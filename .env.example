# Copy to .env, fill in, and load it into your shell before running anything:
#   bash/zsh:   set -a; source .env; set +a
#   PowerShell: Get-Content .env | Where-Object { $_ -match '^[A-Z_]+=' } |
#                 ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }
# langchain-space reads these from the environment; it does not read .env itself.
# .env is gitignored: never commit real tokens.

# --- SPACE native API (required for anything real) ---------------------------------------
SPACE_API_URL=http://127.0.0.1:8080
SPACE_DATA_PLANE_URL=http://127.0.0.1:8090
# A session token. On a local install:
#   curl -s -X POST "$SPACE_API_URL/auth/v1/sessions" -H 'content-type: application/json' \
#     -d '{"email":"root@local","password":"password"}' | jq -r .token
SPACE_API_TOKEN=

# --- SPACE's E2B-compatible API (forks) ---------------------------------------------------
# Needed by SpaceCheckpointer (rewind and branch) and fork_and_select; a plain SpaceSandbox
# works without. On a local Kind install it is the API port itself. The key must belong to
# the same SPACE organization as SPACE_API_TOKEN (see README, "Configure").
SPACE_ECW_API_URL=http://127.0.0.1:8080
SPACE_ECW_API_KEY=

# --- Integration tests ---------------------------------------------------------------------
# Template the tests create sandboxes from. It needs python3 and a POSIX shell.
SPACE_TEMPLATE=code-runtime

# Only for tests/integration/test_space_credentials.py (needs SPACE on AWS; see
# docs/credential-injection.md).
# SPACE_TEST_SECRET_ARN=
# SPACE_TEST_SECRET_SHA256=
# SPACE_TEST_ECHO_URL=
